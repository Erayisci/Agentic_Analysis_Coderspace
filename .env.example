# Copy to .env (gitignored). backend/core/config.py reads this file; the web-tools
# extension reads only the process environment, so export WEB_* vars (or use
# extensions/web_tools/manage.py) when enabling it.
KLOUDEKS_API_KEY=
EVDS_API_KEY=

# Optional SearXNG + Crawl4AI web tools (extensions/web_tools/). Off by default.
# Full list of switches: extensions/web_tools/.env.example
WEB_TOOLS_ENABLED=false
WEB_AGENT_ENABLED=false
WEB_DOCUMENTS_ENABLED=false
WEB_SEARXNG_URL=http://127.0.0.1:8888
WEB_CRAWLER_URL=http://127.0.0.1:8932

# Persistent web evidence (defaults to data/research.sqlite3). Back this up;
# unlike the analytics lakehouse it cannot be recreated from committed data.
# RESEARCH_DB_PATH=/absolute/path/to/research.sqlite3
