# Copy to .env (gitignored). backend/core/config.py reads this file; the web-tools
# extension reads only the process environment, so export WEB_* vars (or use
# extensions/web_tools/manage.py) when enabling it.
KLOUDEKS_API_KEY=
EVDS_API_KEY=

# Optional SearXNG + Crawl4AI web tools (extensions/web_tools/). Off by default.
# Full list of switches: extensions/web_tools/.env.example
WEB_TOOLS_ENABLED=false
# The extension's bounded research loop (the website's 'Web arastirmasi' mode and
# search questions); needs WEB_TOOLS_ENABLED=true and the containers running.
WEB_AGENT_ENABLED=false
WEB_DOCUMENTS_ENABLED=false
WEB_SEARXNG_URL=http://127.0.0.1:8888
WEB_CRAWLER_URL=http://127.0.0.1:8932
# Demo-day source ingestion (backend/ingestion/external). Nothing to set for the
# in-process route: pip install -e ".[dev,ingest]" and it runs inside the API.
# With WEB_TOOLS_ENABLED=true the extension's containers extract instead; then
# also export WEB_DOCUMENTS_ENABLED=true WEB_IMAGES_ENABLED=true WEB_LINKS_ENABLED=true
# WEB_OCR_ENABLED=true WEB_OCR_PROVIDER=kloudeks WEB_ASSET_MAX_ROWS=2000 WEB_ASSET_MAX_SHEETS=20
# WEB_ASSET_MAX_PAGES=50 WEB_ASSET_MAX_CHARS=50000.
# KKB_DATA_DIR relocates data/ (Docker volume); WEB_ASSET_CACHE_DIR defaults to data/external/_cache.

# The log of web evidence every turn used (defaults to data/research.duckdb).
# Unlike the analytics lakehouse it cannot be recreated from committed data.
# RESEARCH_DB_PATH=/absolute/path/to/research.duckdb
