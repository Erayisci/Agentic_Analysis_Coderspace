# Explicit opt-in: setup/start do not enable the tools in the host application.
WEB_TOOLS_ENABLED=false
# setup fills these two private values once and preserves them on reruns.
WEB_COMPOSE_PROJECT=
SEARXNG_SECRET=

# Host listeners are bound to 127.0.0.1. Choose other free ports if needed.
WEB_SEARCH_PORT=8888
WEB_CRAWLER_PORT=8932
# Empty URLs derive from the ports above. Override for your own services.
WEB_SEARXNG_URL=
WEB_CRAWLER_URL=
WEB_SEARCH_TIMEOUT_SECONDS=15
WEB_CRAWL_TIMEOUT_SECONDS=45
WEB_MAX_RESULTS=10
WEB_MAX_CONTENT_CHARS=20000
WEB_MAX_CONCURRENCY=2
WEB_RETRIES=1

# Optional document/image/OCR capabilities; service limits cannot be raised by a tool call.
WEB_DOCUMENTS_ENABLED=false
WEB_IMAGES_ENABLED=false
WEB_LINKS_ENABLED=false
WEB_OCR_ENABLED=false
WEB_VISION_ENABLED=false
WEB_ASSET_CACHE_ENABLED=false
WEB_ASSET_MAX_BYTES=10485760
WEB_ASSET_TIMEOUT_SECONDS=120
WEB_ASSET_MAX_CHARS=20000
WEB_ASSET_MAX_PAGES=10
WEB_ASSET_MAX_SHEETS=3
WEB_ASSET_MAX_ROWS=200
WEB_ASSET_MAX_COLUMNS=50
WEB_ASSET_MAX_ARCHIVE_BYTES=52428800
WEB_ASSET_MAX_IMAGE_PIXELS=10000000
WEB_ASSET_IMAGE_EDGE=1600
WEB_ASSET_MAX_LINKS=50
WEB_ASSET_MAX_IMAGES=3
WEB_ASSET_CACHE_TTL_SECONDS=3600
WEB_ASSET_CACHE_MAX_BYTES=104857600
WEB_OCR_MAX_PAGES=3
WEB_OCR_PROVIDER=local
WEB_OCR_LANGUAGES=eng+tur
WEB_MODEL_MAX_CALLS_PER_READ=1
WEB_MODEL_MAX_CALLS_PER_HOUR=20
WEB_MODEL_MAX_TOKENS=2048
WEB_KLOUDEKS_BASE_URL=https://mia.csp.kloudeks.com/v1
WEB_KLOUDEKS_VISION_MODEL=kkbhackathon2026/Qwen3.8-27B
WEB_KLOUDEKS_OCR_MODEL=kkbhackathon2026/Unlimited-OCR
WEB_KLOUDEKS_API_KEY=
