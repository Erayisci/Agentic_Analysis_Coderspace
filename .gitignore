# Analytics outputs plus local research.sqlite3 (persistent; back it up).
data/

# Spreadsheet lock files (created while a workbook is open)
**/~$*.xlsx
**/.~lock.*#

# BDDK workbooks are a derived rendering of bddk_aylik_bulten/_raw_json/, which
# is the source of truth and IS committed. Regenerate them without network via:
#   python -m backend.ingestion.bddk_bulletin --from-cache
bddk_aylik_bulten/*/*.xlsx

# Python
*.egg-info/
build/
dist/
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Secrets (EVDS_API_KEY lives here; see backend/core/config.py)
.env

# Editor state: the DuckDB extension rewrites this with machine-specific paths
.vscode/
